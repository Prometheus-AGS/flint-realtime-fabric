# flint-realtime-fabric — environment variable template
#
# Copy to `.env` (gitignored) and fill in real values, or provide these via your
# orchestrator's secret manager. Never commit real secrets.
#
# Full reference (purpose / required / secret / dev-only for every var):
#   docs/ENVIRONMENT.md
#
# Lines below are grouped like that reference. Uncommented lines are the minimum
# required to boot; commented lines show optional vars with their defaults.

# ─── REQUIRED to boot (production) ───

# Iggy broker DSN — contains credentials (SECRET).
IGGY_CONNECTION_STRING=iggy://iggy:iggy@iggy-server:8090
# Ory Keto read/write API base URL.
KETO_BASE_URL=http://keto:4466
# flint-gate JWKS endpoint used to verify inbound JWTs.
GATEWAY_JWKS_URL=http://flint-gate:4457/signing-keys
# Expected JWT audience (aud).
JWT_AUDIENCE=frf-gateway

# ─── Secrets (REQUIRED where used — no defaults, never commit real values) ───

# HMAC/JWT signing secret used by the flint-gate service to mint outbound JWTs.
# Production `compose.yml` fails to start if this is unset. Rotate on any exposure.
FLINT_GATE_JWT_SECRET=change-me-generate-a-strong-random-secret

# ─── Core / networking (optional — defaults shown) ───

# BIND_ADDR=0.0.0.0:8080
# GRPC_PORT=9090          # 0 disables the gRPC server
# RUST_LOG=info

# ─── Identity & authorization ───

# Expected JWT issuer (iss). RECOMMENDED in production; when unset the gateway logs
# a warning and does NOT validate the token issuer. (p16-c004)
# JWT_ISSUER=https://your-idp.example.com
# KETO_NAMESPACE=default
# POLICY_ENGINE=none      # or "cedar"

# DEV-ONLY BYPASS — NEVER set in production. Only has effect in a `dev-endpoints`
# build; the release image is built without it. (p16-c001)
# DEV_NO_AUTH=true

# ─── Security middleware (optional — defaults shown) (p16-c005) ───

# RATE_LIMIT_PER_SEC=50
# RATE_LIMIT_BURST=100
# MAX_BODY_BYTES=1048576
# Comma-separated exact-match CORS origins; empty = no cross-origin browser access.
# CORS_ALLOWED_ORIGINS=https://admin.example.com

# ─── Media / SFU (p16-c010) ───
#
# SFU_MODE: "hosted" → LiveKit (supported v1 path); "sovereign" → str0m (DEFERRED,
# NO media flows). Default "hosted" — LIVEKIT_* are then REQUIRED (validated at boot).
# SFU_MODE=hosted
# LIVEKIT_API_KEY=            # SECRET, required when SFU_MODE=hosted
# LIVEKIT_API_SECRET=         # SECRET, required when SFU_MODE=hosted
# LIVEKIT_SERVER_URL=         # required when SFU_MODE=hosted
# LIVEKIT_ROOM_PREFIX=frf/

# ─── CDC — Postgres logical replication (off by default) (p16-c020) ───
#
# When CDC_ENABLED=true, the *_URL/SLOT/PUBLICATION vars are REQUIRED (validated at boot).
# CDC_ENABLED=false
# CDC_REPLICATION_URL=postgres://frf:frf@postgres:5432/frf   # SECRET
# CDC_SLOT_NAME=frf_slot
# CDC_PUBLICATION_NAME=frf_pub
# CDC_TENANT_ID=00000000-0000-0000-0000-000000000001
# CDC_CHANNEL_PATH=entities

# ─── Federation (DEFERRED / half-implemented in v1 — off by default) (p16-c009) ───
#
# Matrix: OUTBOUND send works, INBOUND is a stub. ATProto: INBOUND works, OUTBOUND
# unsupported. When enabled, FEDERATION_TENANT_ID is REQUIRED so ingested events land
# where subscribers can see them.
# FEDERATION_ENABLED=false
# FEDERATION_TENANT_ID=00000000-0000-0000-0000-000000000000
# FEDERATION_CHANNEL_ID=00000000-0000-0000-0000-000000000000
# MATRIX_HOMESERVER_URL=
# MATRIX_ACCESS_TOKEN=        # SECRET
# MATRIX_ROOM_ID=
# ATPROTO_JETSTREAM_URL=
# ATPROTO_COLLECTIONS=

# ─── Actor registry / eviction (optional — defaults shown) ───

# REGISTRY_IDLE_SECS=300
# REGISTRY_SWEEP_INTERVAL_SECS=60

# ─── Observability (optional) ───

# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=frf-gateway
# /metrics (Prometheus) is always available and needs no env config. (p16-c018)
